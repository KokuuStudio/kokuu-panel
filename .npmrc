# ★ 这里**不要**写 registry=...
#
#   国内网络下不换源，npm install 会卡到超时；但把国内镜像写死在这里
#   会连带影响所有其他人 —— 尤其 CI：
#     - lockfile 里的 resolved 字段本来就是写死的下载地址
#     - npm 的 replace-registry-host 默认 `npmjs`，只替换 npmjs 的 host
#       → 换源参数对 npmmirror 无效，境外构建会去连国内源
#   这是「为本机优化、坑了所有人」的典型。
#
#   按需换源（写 ~/.npmrc，只影响本机、不提交）：
#     npm config set registry https://registry.npmmirror.com
#   或临时：
#     npm install --registry=https://registry.npmmirror.com --replace-registry-host=always
fund=false
audit=false

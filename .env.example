# 复制成 .env 后填写。docker compose 会自动读取。

# 会话签名密钥。多实例部署时所有实例必须一致。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KP_SESSION_SECRET=

# 初始管理员。只在数据库里还没有任何账号时生效。
KP_ADMIN_USER=admin
# 至少 8 位。别用 admin123 —— 这个服务通常挂在公网上。
KP_ADMIN_PASSWORD=

# debug / info / warn / error
KP_LOG_LEVEL=info

# ── 不用 Docker 时 ───────────────────────────────────────────
# 直接 `node apps/server/src/index.ts` 的话，这些可选：
# KP_HOST=127.0.0.1
# KP_PORT=8787
# KP_DATA_DIR=data
# KP_WEB_DIST=apps/web/dist
#
# 反向代理后面才打开。直接监听时打开它 = 任何人都能伪造来源 IP，
# 而登录限流与审计都依赖来源 IP。
# KP_TRUST_PROXY=1

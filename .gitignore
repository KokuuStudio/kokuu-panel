node_modules/
dist/
*.log

# ── 临时工作区 ────────────────────────────────────────────────
# 这里放过反编译出来的第三方插件源码、下载的 jar、以及带凭据的脚本。
# 绝不能提交：里面可能有付费插件的代码和明文密钥。
.tmp/
.pnpm-store/

# ── 运行期数据 ────────────────────────────────────────────────
# SQLite 库里有节点密钥哈希与账号数据；session.key 是会话签名密钥。
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
session.key

# ── Java 构建产物 ─────────────────────────────────────────────
# 用不带前导斜杠的 target/ ：Maven 模块是多个（agent/、legacy-fix/），
# 每加一个模块都要记得来这里补一行才是真正的坑。
# 写成通用规则，新模块自动被覆盖。
target/
*.class
*.jar

# 构建产物里的 jar 不该提交，但**源码仓库里的** jar 形态的
# 测试夹具（如果有）需要单独用 ! 放行：
# !tools/fixtures/*.jar

# ── 本地配置 ──────────────────────────────────────────────────
.env
.env.local

# ── 编辑器 ────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.DS_Store

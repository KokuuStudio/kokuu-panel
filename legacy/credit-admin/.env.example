# ══════════════════════════════════════════════════════════════
#  kokuu-credit-admin 环境变量
# ══════════════════════════════════════════════════════════════
#
#  用法：cp .env.example .env 然后改下面带 ⚠️ 的项。
#  .env 里含口令，不要提交到 git（已在 .gitignore 里）。

# ── 管理端 ────────────────────────────────────────────────────
# ⚠️ 必须改。这是登录管理台的口令，改成你自己的随机串。
#    生成：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# ── 运行模式 ──────────────────────────────────────────────────
# standalone  用本项目自带的 MySQL（docker compose 默认档）
# skin        连已有的皮肤站数据库（docker compose --profile skin）
BACKEND=standalone

# ── 数据库 ────────────────────────────────────────────────────
# standalone：以下三项保持默认即可（用容器内的 mysql 服务）
# skin：改成皮肤站的实际库，DB_HOST 填皮肤站主机名或内网 IP
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kokuu
DB_USERNAME=kokuu
# ⚠️ skin 模式下改成皮肤站那个 kokuu 用户的密码
DB_PASSWORD=kokuu_app_pw
# 仅 standalone 用：内置 MySQL 的 root 密码
MYSQL_ROOT_PASSWORD=kokuu_root_pw

# ── Redis ─────────────────────────────────────────────────────
# standalone：保持默认（用容器内的 redis 服务）
# skin：填皮肤站的 Redis。⚠️ 队列键名必须与皮肤站/插件一致 ——
#   Laravel 门面会给键加 blessing_skin_database_ 前缀，
#   而插件与本服务用裸客户端、键名是字面量。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ASSET_KEY=bs:asset:cmd
REDIS_EVENT_KEY=bs:asset:event

# ── 金币自动回流 ──────────────────────────────────────────────
# 后台配置页（/config）里也能改，这里的值只是**首次启动的初始值**。
# 真正决定是否入账的是数据库里的值，改这里不会覆盖已有配置。
REFLOW_ENABLED=0

# ── 对外监听 ──────────────────────────────────────────────────
# ⚠️ 默认只绑 127.0.0.1，前面放 nginx/Caddy 做 TLS。
#    直接改成 0.0.0.0 或写 "8787:8787" 的话，管理口令和账本数据
#    都在明文里传输 —— 公网环境下这是不能接受的。
BIND_ADDR=127.0.0.1
BIND_PORT=8787
